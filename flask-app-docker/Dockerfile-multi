
# Build Stage: Use Python 3.9 slim image to install dependencies and prepare the application
FROM python:3.9-slim AS builder

# Set the working directory inside the builder container
WORKDIR /app

# Copy the dependency list into the container
COPY requirements.txt .

# Install Python dependencies into a separate directory (/app/deps)
# --no-cache-dir avoids storing pip's download cache
# --target installs packages into the specified directory
RUN pip install --no-cache-dir -r requirements.txt --target=/app/deps

# Copy the application source code into the builder stage
COPY . .

# Final Stage: Use a minimal Distroless Python image without a shell or package manager
FROM gcr.io/distroless/python3-debian11

# Set the working directory inside the final container
WORKDIR /apprun

# Copy only the installed dependencies from the builder stage
COPY --from=builder /app/deps /apprun/deps

# Copy the application files from the builder stage into the final image
#Notice here we are just copying the applications run time required files we are not copying the requirements.txt coz that haas been already copied form build stage
COPY --from=builder /app/run.py .
COPY --from=builder /app/app.py .

# COPY --from=builder /app . # It copies everything

# Send Python output directly to the container logs without buffering
ENV PYTHONUNBUFFERED=1

# Tell Python where to find the installed dependencies
ENV PYTHONPATH="/apprun/deps"

# Document that the application is intended to use port 80
EXPOSE 80

# The Distroless Python image provides a Python ENTRYPOINT
# CMD supplies the script argument to that inherited executable
# Together, they execute the equivalent of: python run.py
CMD ["run.py"]



